<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Mobdev" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF9500</item>
        <item name="colorPrimaryVariant">#FF9500</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF9500</item>
        <item name="colorSecondaryVariant">#FF9500</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#1C1C1E</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="CalcButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>

    <style name="CalcButtonDark" parent="CalcButtonBase">
        <item name="backgroundTint">#2C2C2E</item>
    </style>

    <style name="CalcButtonGray" parent="CalcButtonBase">
        <item name="backgroundTint">#636366</item>
    </style>

    <style name="CalcButtonOrange" parent="CalcButtonBase">
        <item name="backgroundTint">#FF9500</item>
    </style>
</resources>