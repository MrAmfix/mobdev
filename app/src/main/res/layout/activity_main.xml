<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="20sp"
            android:textColor="#8E8E93"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="56sp"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="0"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btnClear"
                style="@style/CalcButtonGray"
                android:text="AC" />
            <Button android:id="@+id/btnPlusMinus"
                style="@style/CalcButtonGray"
                android:text="+/−" />
            <Button android:id="@+id/btnPercent"
                style="@style/CalcButtonGray"
                android:text="%" />
            <Button android:id="@+id/btnDivide"
                style="@style/CalcButtonOrange"
                android:text="÷" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn7" style="@style/CalcButtonDark" android:text="7" />
            <Button android:id="@+id/btn8" style="@style/CalcButtonDark" android:text="8" />
            <Button android:id="@+id/btn9" style="@style/CalcButtonDark" android:text="9" />
            <Button android:id="@+id/btnMultiply"
                style="@style/CalcButtonOrange"
                android:text="×" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn4" style="@style/CalcButtonDark" android:text="4" />
            <Button android:id="@+id/btn5" style="@style/CalcButtonDark" android:text="5" />
            <Button android:id="@+id/btn6" style="@style/CalcButtonDark" android:text="6" />
            <Button android:id="@+id/btnMinus"
                style="@style/CalcButtonOrange"
                android:text="−" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn1" style="@style/CalcButtonDark" android:text="1" />
            <Button android:id="@+id/btn2" style="@style/CalcButtonDark" android:text="2" />
            <Button android:id="@+id/btn3" style="@style/CalcButtonDark" android:text="3" />
            <Button android:id="@+id/btnPlus"
                style="@style/CalcButtonOrange"
                android:text="+" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btnBackspace"
                style="@style/CalcButtonGray"
                android:text="⌫" />
            <Button android:id="@+id/btn0" style="@style/CalcButtonDark" android:text="0" />
            <Button android:id="@+id/btnDot"
                style="@style/CalcButtonDark"
                android:text="." />
            <Button android:id="@+id/btnEquals"
                style="@style/CalcButtonOrange"
                android:text="=" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>